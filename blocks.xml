<?xml version="1.0" encoding="utf-8"?>
<EditorDefinitions>
  <PolyGroups ModuleName="ColorSensorRGB" ModuleVersion="2.0 (Multi-language + ColorClassifier)">
	<PolyGroup Name="ColorSensorRGB" BlockFamily="Sensor">
      <Parameter Name="Port" CompilerDirectives="OneInputPort" Direction="Input" DefaultValue="1.3" />
      <Parameter Name="Red" Identification="Identification_Red.png" DataType="Single" Direction="Output" />
      <Parameter Name="Green" Identification="Identification_Green.png" DataType="Single" Direction="Output" />
      <Parameter Name="Blue" Identification="Identification_Blue.png" DataType="Single" Direction="Output" />
	
	  <Parameter Name="Red_Range" Identification="Identification_Red.png" DataType="Single" Direction="Input" DefaultValue="170"/>
	  <Parameter Name="Green_Range" Identification="Identification_Green.png" DataType="Single" Direction="Input" DefaultValue="160"/>
	  <Parameter Name="Blue_Range" Identification="Identification_Blue.png" DataType="Single" Direction="Input" DefaultValue="120"/>
	  <Parameter Name="Error_Amount" Identification="Identification_er.png" DataType="Single" Direction="Input" DefaultValue="20"/>
	  <Parameter Name="Result" Identification="Identification_Select.png" DataType="Boolean" Direction="Output"/>
	
	  <Parameter Name="Hue" Identification="Identification_H.png" DataType="Single" Direction="Output" />
      <Parameter Name="Lightness" Identification="Identification_L.png" DataType="Single" Direction="Output" />
      <Parameter Name="Saturation" Identification="Identification_S.png" DataType="Single" Direction="Output" />
      <Parameter Name="Value" Identification="Identification_V.png" DataType="Single" Direction="Output" />
      <Hardware>
        <NXTPlotColor>#ffff3132</NXTPlotColor>
        <EV3PlotColor>#ff785028</EV3PlotColor>
        <EV3AutoID>29</EV3AutoID>
        <OtherAutoID>4</OtherAutoID>
        <OtherAutoID>2</OtherAutoID>
        <Direction>Input</Direction>
        <DefaultPort>1.3</DefaultPort>
      </Hardware>
      <Block>
        <Mode>ReadRGB</Mode>
        <Reference Type="VILib" Name="ColorSensorRGBValue.vix" />
        <ParameterReference Name="Port" />
        <ParameterReference Name="Red" />
        <ParameterReference Name="Green" />
        <ParameterReference Name="Blue" />
        <PaletteInfo Weight="0.5" />
        <Flags>PBROnly</Flags>
        <Hardware>RudolphColor</Hardware>
      </Block>
	  <Block>
        <Mode>ReadHSV</Mode>
        <Reference Type="VILib" Name="OFDL_EV3Color_HSV.vix" />
        <ParameterReference Name="Port" />
        <ParameterReference Name="Hue" />
        <ParameterReference Name="Saturation" />
        <ParameterReference Name="Value" />
        <ParameterReference Name="Lightness" />
        <Flags>PBROnly</Flags>
        <Hardware>RudolphColor</Hardware>
      </Block>
	  <Block>
        <Mode>DectRGB</Mode>
        <Reference Type="VILib" Name="ColorSensorRGBDect.vix" />
        <ParameterReference Name="Port" />
		<ParameterReference Name="Red" />
        <ParameterReference Name="Green" />
        <ParameterReference Name="Blue" />
		<ParameterReference Name="Error_Amount" />
        <ParameterReference Name="Red_Range" />
        <ParameterReference Name="Green_Range" />
        <ParameterReference Name="Blue_Range" />
        <ParameterReference Name="Result" />
        <Flags>PBROnly</Flags>
        <Hardware>RudolphColor</Hardware>
      </Block>

    </PolyGroup>

    <PolyGroup Name="ColorClassifier" BlockFamily="DataOperations">
      <Parameter Name="R_in" Identification="Identification_Red.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="G_in" Identification="Identification_Green.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="B_in" Identification="Identification_Blue.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="R_n" Identification="Identification_Red.png" DataType="Single" Direction="Output" />
      <Parameter Name="G_n" Identification="Identification_Green.png" DataType="Single" Direction="Output" />
      <Parameter Name="B_n" Identification="Identification_Blue.png" DataType="Single" Direction="Output" />

      <Parameter Name="Ref_R" Identification="Identification_Red.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="Ref_G" Identification="Identification_Green.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="Ref_B" Identification="Identification_Blue.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="D_Red" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="D_Green" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="D_Blue" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="D_Yellow" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="D_White" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="D_Black" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="D_Brown" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="D_Pink" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="D_Red_in" Identification="Identification_Select.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="D_Green_in" Identification="Identification_Select.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="D_Blue_in" Identification="Identification_Select.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="D_Yellow_in" Identification="Identification_Select.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="D_White_in" Identification="Identification_Select.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="D_Black_in" Identification="Identification_Select.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="D_Brown_in" Identification="Identification_Select.png" DataType="Single" Direction="Input" DefaultValue="0" />
      <Parameter Name="D_Pink_in" Identification="Identification_Select.png" DataType="Single" Direction="Input" DefaultValue="0" />

      <Parameter Name="BestColor" Identification="Identification_Select.png" DataType="Single" Direction="Output" />
      <Parameter Name="BestDistance" Identification="Identification_Select.png" DataType="Single" Direction="Output" />

      <Block>
        <Mode>Normalize</Mode>
        <Reference Type="VILib" Name="ColorClassifier_Normalize.vix" />
        <ParameterReference Name="R_in" />
        <ParameterReference Name="G_in" />
        <ParameterReference Name="B_in" />
        <ParameterReference Name="R_n" />
        <ParameterReference Name="G_n" />
        <ParameterReference Name="B_n" />
        <PaletteInfo Weight="0.5" />
        <Flags>PBROnly</Flags>
      </Block>
      <Category Name="Setup">
        <Block>
          <Mode>Setup_Red</Mode>
          <Reference Type="VILib" Name="ColorClassifier_Setup_Red.vix" />
          <ParameterReference Name="Ref_R" />
          <ParameterReference Name="Ref_G" />
          <ParameterReference Name="Ref_B" />
          <Flags>PBROnly</Flags>
        </Block>
        <Block>
          <Mode>Setup_Green</Mode>
          <Reference Type="VILib" Name="ColorClassifier_Setup_Green.vix" />
          <ParameterReference Name="Ref_R" />
          <ParameterReference Name="Ref_G" />
          <ParameterReference Name="Ref_B" />
          <Flags>PBROnly</Flags>
        </Block>
        <Block>
          <Mode>Setup_Blue</Mode>
          <Reference Type="VILib" Name="ColorClassifier_Setup_Blue.vix" />
          <ParameterReference Name="Ref_R" />
          <ParameterReference Name="Ref_G" />
          <ParameterReference Name="Ref_B" />
          <Flags>PBROnly</Flags>
        </Block>
        <Block>
          <Mode>Setup_Yellow</Mode>
          <Reference Type="VILib" Name="ColorClassifier_Setup_Yellow.vix" />
          <ParameterReference Name="Ref_R" />
          <ParameterReference Name="Ref_G" />
          <ParameterReference Name="Ref_B" />
          <Flags>PBROnly</Flags>
        </Block>
        <Block>
          <Mode>Setup_White</Mode>
          <Reference Type="VILib" Name="ColorClassifier_Setup_White.vix" />
          <ParameterReference Name="Ref_R" />
          <ParameterReference Name="Ref_G" />
          <ParameterReference Name="Ref_B" />
          <Flags>PBROnly</Flags>
        </Block>
        <Block>
          <Mode>Setup_Black</Mode>
          <Reference Type="VILib" Name="ColorClassifier_Setup_Black.vix" />
          <ParameterReference Name="Ref_R" />
          <ParameterReference Name="Ref_G" />
          <ParameterReference Name="Ref_B" />
          <Flags>PBROnly</Flags>
        </Block>
        <Block>
          <Mode>Setup_Brown</Mode>
          <Reference Type="VILib" Name="ColorClassifier_Setup_Brown.vix" />
          <ParameterReference Name="Ref_R" />
          <ParameterReference Name="Ref_G" />
          <ParameterReference Name="Ref_B" />
          <Flags>PBROnly</Flags>
        </Block>
        <Block>
          <Mode>Setup_Pink</Mode>
          <Reference Type="VILib" Name="ColorClassifier_Setup_Pink.vix" />
          <ParameterReference Name="Ref_R" />
          <ParameterReference Name="Ref_G" />
          <ParameterReference Name="Ref_B" />
          <Flags>PBROnly</Flags>
        </Block>
      </Category>
      <Block>
        <Mode>Distance</Mode>
        <Reference Type="VILib" Name="ColorClassifier_Distance.vix" />
        <ParameterReference Name="R_in" />
        <ParameterReference Name="G_in" />
        <ParameterReference Name="B_in" />
        <ParameterReference Name="D_Red" />
        <ParameterReference Name="D_Green" />
        <ParameterReference Name="D_Blue" />
        <ParameterReference Name="D_Yellow" />
        <ParameterReference Name="D_White" />
        <ParameterReference Name="D_Black" />
        <ParameterReference Name="D_Brown" />
        <ParameterReference Name="D_Pink" />
        <Flags>PBROnly</Flags>
      </Block>
      <Block>
        <Mode>Identify</Mode>
        <Reference Type="VILib" Name="ColorClassifier_Identify.vix" />
        <ParameterReference Name="D_Red_in" />
        <ParameterReference Name="D_Green_in" />
        <ParameterReference Name="D_Blue_in" />
        <ParameterReference Name="D_Yellow_in" />
        <ParameterReference Name="D_White_in" />
        <ParameterReference Name="D_Black_in" />
        <ParameterReference Name="D_Brown_in" />
        <ParameterReference Name="D_Pink_in" />
        <ParameterReference Name="BestColor" />
        <ParameterReference Name="BestDistance" />
        <Flags>PBROnly</Flags>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorDefinitions>

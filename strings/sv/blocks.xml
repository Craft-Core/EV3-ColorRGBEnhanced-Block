<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="Färgsensor RGB Utvidgad" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="Port">
        <Description><![CDATA[<p>Sensorport (1–4) för EV3-färgsensorn</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="Röd">
        <Description><![CDATA[<p>Röd komponent av RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="Grön">
        <Description><![CDATA[<p>Grön komponent av RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="Blå">
        <Description><![CDATA[<p>Blå komponent av RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="Röd referens">
        <Description><![CDATA[<p>Röd referensvärde att jämföra mot</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="Grön referens">
        <Description><![CDATA[<p>Grön referensvärde att jämföra mot</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="Blå referens">
        <Description><![CDATA[<p>Blå referensvärde att jämföra mot</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="Tolerans">
        <Description><![CDATA[<p>Tillåten avvikelse per kanal för positiv träff</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="Träff">
        <Description><![CDATA[<p>Sant när mätt RGB är inom toleransen</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="Nyans">
        <Description><![CDATA[<p>Nyanskomponent (0–360 grader)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="Mättnad">
        <Description><![CDATA[<p>Mättnadskomponent (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="Värde">
        <Description><![CDATA[<p>Värde/ljusstyrka (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="Ljushet">
        <Description><![CDATA[<p>Ljushet (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="Mät – RGB-färg">
        <Description><![CDATA[<p>Läs råa Röd-, Grön- och Blå-värden från färgsensorn.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="Mät – HSVL-färg">
        <Description><![CDATA[<p>Läs nyans, mättnad, värde och ljushet härledda från sensorns RGB.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="Jämför – RGB-färg">
        <Description><![CDATA[<p>Jämför live RGB med en referenstrippel och returnera ett booleskt värde.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="Färgklassificerare" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>Avståndsbaserade färgklassificeringsverktyg för fliken Dataåtgärder.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="R-ingång">
        <Description><![CDATA[<p>Live röd kanalvärde att klassificera</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="G-ingång">
        <Description><![CDATA[<p>Live grön kanalvärde att klassificera</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="B-ingång">
        <Description><![CDATA[<p>Live blå kanalvärde att klassificera</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>Normaliserad röd: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>Normaliserad grön: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>Normaliserad blå: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="Referens R">
        <Description><![CDATA[<p>Röd värde för förinställd färg som ska sparas</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="Referens G">
        <Description><![CDATA[<p>Grön värde för förinställd färg som ska sparas</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="Referens B">
        <Description><![CDATA[<p>Blå värde för förinställd färg som ska sparas</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Red" DisplayName="Aktivera Röd">
        <Description><![CDATA[<p>1 = inkludera Röd i klassificering, 0 = ignorera Röd</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Green" DisplayName="Aktivera Grön">
        <Description><![CDATA[<p>1 = inkludera Grön i klassificering, 0 = ignorera Grön</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Blue" DisplayName="Aktivera Blå">
        <Description><![CDATA[<p>1 = inkludera Blå i klassificering, 0 = ignorera Blå</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Yellow" DisplayName="Aktivera Gul">
        <Description><![CDATA[<p>1 = inkludera Gul i klassificering, 0 = ignorera Gul</p>]]></Description>
      </Parameter>
      <Parameter Name="En_White" DisplayName="Aktivera Vit">
        <Description><![CDATA[<p>1 = inkludera Vit i klassificering, 0 = ignorera Vit</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Black" DisplayName="Aktivera Svart">
        <Description><![CDATA[<p>1 = inkludera Svart i klassificering, 0 = ignorera Svart</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Brown" DisplayName="Aktivera Brun">
        <Description><![CDATA[<p>1 = inkludera Brun i klassificering, 0 = ignorera Brun</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Pink" DisplayName="Aktivera Rosa">
        <Description><![CDATA[<p>1 = inkludera Rosa i klassificering, 0 = ignorera Rosa</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="Bästa färg">
        <Description><![CDATA[<p>Index (1–8) för närmaste förinställda färg</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="Bästa avstånd">
        <Description><![CDATA[<p>Avstånd till närmaste förinställda färg</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="Röd">
        <Description><![CDATA[<p>Kvadrerat avstånd från inmatnings-RGB till Röd-referens</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="Grön">
        <Description><![CDATA[<p>Kvadrerat avstånd från inmatnings-RGB till Grön-referens</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="Blå">
        <Description><![CDATA[<p>Kvadrerat avstånd från inmatnings-RGB till Blå-referens</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="Gul">
        <Description><![CDATA[<p>Kvadrerat avstånd från inmatnings-RGB till Gul-referens</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="Vit">
        <Description><![CDATA[<p>Kvadrerat avstånd från inmatnings-RGB till Vit-referens</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="Svart">
        <Description><![CDATA[<p>Kvadrerat avstånd från inmatnings-RGB till Svart-referens</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="Brun">
        <Description><![CDATA[<p>Kvadrerat avstånd från inmatnings-RGB till Brun-referens</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="Rosa">
        <Description><![CDATA[<p>Kvadrerat avstånd från inmatnings-RGB till Rosa-referens</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="Röd">
        <Description><![CDATA[<p>Avstånd till Röd (från Distance-läge)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="Grön">
        <Description><![CDATA[<p>Avstånd till Grön (från Distance-läge)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="Blå">
        <Description><![CDATA[<p>Avstånd till Blå (från Distance-läge)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="Gul">
        <Description><![CDATA[<p>Avstånd till Gul (från Distance-läge)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="Vit">
        <Description><![CDATA[<p>Avstånd till Vit (från Distance-läge)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="Svart">
        <Description><![CDATA[<p>Avstånd till Svart (från Distance-läge)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="Brun">
        <Description><![CDATA[<p>Avstånd till Brun (från Distance-läge)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="Rosa">
        <Description><![CDATA[<p>Avstånd till Rosa (från Distance-läge)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_R" DisplayName="R (Röd)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_G" DisplayName="G (Röd)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_B" DisplayName="B (Röd)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_R" DisplayName="R (Grön)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_G" DisplayName="G (Grön)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_B" DisplayName="B (Grön)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_R" DisplayName="R (Blå)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_G" DisplayName="G (Blå)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_B" DisplayName="B (Blå)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_R" DisplayName="R (Gul)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_G" DisplayName="G (Gul)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_B" DisplayName="B (Gul)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_R" DisplayName="R (Vit)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_G" DisplayName="G (Vit)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_B" DisplayName="B (Vit)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_R" DisplayName="R (Svart)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_G" DisplayName="G (Svart)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_B" DisplayName="B (Svart)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_R" DisplayName="R (Brun)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_G" DisplayName="G (Brun)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_B" DisplayName="B (Brun)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_R" DisplayName="R (Rosa)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_G" DisplayName="G (Rosa)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>

<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="컬러 센서 RGB Enhanced" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="포트">
        <Description><![CDATA[<p>EV3 컬러 센서가 연결된 포트 (1–4)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="빨강">
        <Description><![CDATA[<p>RGB의 빨강 성분 (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="초록">
        <Description><![CDATA[<p>RGB의 초록 성분 (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="파랑">
        <Description><![CDATA[<p>RGB의 파랑 성분 (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="빨강 기준값">
        <Description><![CDATA[<p>비교할 빨강 기준값</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="초록 기준값">
        <Description><![CDATA[<p>비교할 초록 기준값</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="파랑 기준값">
        <Description><![CDATA[<p>비교할 파랑 기준값</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="허용 오차">
        <Description><![CDATA[<p>일치로 간주하기 위한 채널별 허용 오차</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="일치">
        <Description><![CDATA[<p>측정한 RGB가 오차 범위 내면 참</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="색조">
        <Description><![CDATA[<p>색조 성분 (0–360도)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="채도">
        <Description><![CDATA[<p>채도 성분 (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="명도">
        <Description><![CDATA[<p>명도/밝기 (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="밝기">
        <Description><![CDATA[<p>밝기 (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="측정 – RGB 컬러">
        <Description><![CDATA[<p>컬러 센서에서 원시 빨강, 초록, 파랑 값을 읽습니다.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="측정 – HSVL 컬러">
        <Description><![CDATA[<p>센서의 RGB로부터 색조, 채도, 명도, 밝기를 읽습니다.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="비교 – RGB 컬러">
        <Description><![CDATA[<p>실시간 RGB를 기준과 비교하여 부울 값을 반환합니다.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="컬러 분류기" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>데이터 조작 탭용 거리 기반 컬러 분류 유틸리티.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="R 입력">
        <Description><![CDATA[<p>분류할 실시간 빨강 값</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="G 입력">
        <Description><![CDATA[<p>분류할 실시간 초록 값</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="B 입력">
        <Description><![CDATA[<p>분류할 실시간 파랑 값</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>정규화된 빨강: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>정규화된 초록: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>정규화된 파랑: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="기준 R">
        <Description><![CDATA[<p>저장할 프리셋 컬러의 빨강 값</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="기준 G">
        <Description><![CDATA[<p>저장할 프리셋 컬러의 초록 값</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="기준 B">
        <Description><![CDATA[<p>저장할 프리셋 컬러의 파랑 값</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Red" DisplayName="빨강 ON/OFF">
        <Description><![CDATA[<p>1 = 빨강을 분류에 포함, 0 = 빨강 무시</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Green" DisplayName="초록 ON/OFF">
        <Description><![CDATA[<p>1 = 초록을 분류에 포함, 0 = 초록 무시</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Blue" DisplayName="파랑 ON/OFF">
        <Description><![CDATA[<p>1 = 파랑을 분류에 포함, 0 = 파랑 무시</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Yellow" DisplayName="노랑 ON/OFF">
        <Description><![CDATA[<p>1 = 노랑을 분류에 포함, 0 = 노랑 무시</p>]]></Description>
      </Parameter>
      <Parameter Name="En_White" DisplayName="흰색 ON/OFF">
        <Description><![CDATA[<p>1 = 흰색을 분류에 포함, 0 = 흰색 무시</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Black" DisplayName="검정 ON/OFF">
        <Description><![CDATA[<p>1 = 검정을 분류에 포함, 0 = 검정 무시</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Brown" DisplayName="갈색 ON/OFF">
        <Description><![CDATA[<p>1 = 갈색을 분류에 포함, 0 = 갈색 무시</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Pink" DisplayName="분홍 ON/OFF">
        <Description><![CDATA[<p>1 = 분홍을 분류에 포함, 0 = 분홍 무시</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="최근접 컬러">
        <Description><![CDATA[<p>가장 가까운 프리셋 컬러 번호 (1–8)</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="최근접 거리">
        <Description><![CDATA[<p>가장 가까운 컬러까지의 거리</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="빨강">
        <Description><![CDATA[<p>Squared distance from input RGB to 빨강 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="초록">
        <Description><![CDATA[<p>Squared distance from input RGB to 초록 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="파랑">
        <Description><![CDATA[<p>Squared distance from input RGB to 파랑 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="노랑">
        <Description><![CDATA[<p>Squared distance from input RGB to 노랑 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="흰색">
        <Description><![CDATA[<p>Squared distance from input RGB to 흰색 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="검정">
        <Description><![CDATA[<p>Squared distance from input RGB to 검정 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="갈색">
        <Description><![CDATA[<p>Squared distance from input RGB to 갈색 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="분홍">
        <Description><![CDATA[<p>Squared distance from input RGB to 분홍 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="빨강">
        <Description><![CDATA[<p>Distance to 빨강 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="초록">
        <Description><![CDATA[<p>Distance to 초록 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="파랑">
        <Description><![CDATA[<p>Distance to 파랑 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="노랑">
        <Description><![CDATA[<p>Distance to 노랑 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="흰색">
        <Description><![CDATA[<p>Distance to 흰색 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="검정">
        <Description><![CDATA[<p>Distance to 검정 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="갈색">
        <Description><![CDATA[<p>Distance to 갈색 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="분홍">
        <Description><![CDATA[<p>Distance to 분홍 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="정규화 – RGB">
        <Description><![CDATA[<p>원시 R, G, B를 비율로 변환합니다 (각 채널/합계 × 100). 밝기 영향을 제거하고 색상 정보만 남깁니다.</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="설정">
        <Block Mode="Setup_Red" DisplayName="빨강 설정">
          <Description><![CDATA[<p>빨강의 기준 RGB를 저장합니다 (기본값: R=255, G=0, B=0). 프로그램 시작 시 한 번 호출하세요.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="초록 설정">
          <Description><![CDATA[<p>초록의 기준 RGB를 저장합니다 (기본값: R=0, G=255, B=0). 프로그램 시작 시 한 번 호출하세요.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="파랑 설정">
          <Description><![CDATA[<p>파랑의 기준 RGB를 저장합니다 (기본값: R=0, G=0, B=255). 프로그램 시작 시 한 번 호출하세요.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="노랑 설정">
          <Description><![CDATA[<p>노랑의 기준 RGB를 저장합니다 (기본값: R=255, G=255, B=0). 프로그램 시작 시 한 번 호출하세요.</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="흰색 설정">
          <Description><![CDATA[<p>흰색의 기준 RGB를 저장합니다 (기본값: R=255, G=255, B=255). 프로그램 시작 시 한 번 호출하세요.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="검정 설정">
          <Description><![CDATA[<p>검정의 기준 RGB를 저장합니다 (기본값: R=0, G=0, B=0). 프로그램 시작 시 한 번 호출하세요.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="갈색 설정">
          <Description><![CDATA[<p>갈색의 기준 RGB를 저장합니다 (기본값: R=128, G=64, B=0). 프로그램 시작 시 한 번 호출하세요.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="분홍 설정">
          <Description><![CDATA[<p>분홍의 기준 RGB를 저장합니다 (기본값: R=200, G=50, B=150). 프로그램 시작 시 한 번 호출하세요.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Enable" DisplayName="사용할 색상 설정">
          <Description><![CDATA[<p>사용할 색상을 설정합니다 (1=ON, 0=OFF). 비활성화된 색상은 거리 999999를 출력하며 Identify에서 절대 선택되지 않습니다.</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="거리">
        <Description><![CDATA[<p>실시간 RGB에서 8개 프리셋 컬러 각각까지의 제곱 거리를 계산합니다. 출력을 Identify 블록에 연결하세요.</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="식별">
        <Description><![CDATA[<p>Distance 블록에서 8개의 거리를 받아 가장 가까운 컬러의 번호 (1–8)와 실제 거리를 반환합니다.</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>

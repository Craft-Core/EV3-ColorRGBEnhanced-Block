<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="Fargesensor RGB Utvidet" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="Port">
        <Description><![CDATA[<p>Sensorport (1–4) for EV3-fargesensoren</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="Rød">
        <Description><![CDATA[<p>Rød komponent av RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="Grønn">
        <Description><![CDATA[<p>Grønn komponent av RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="Blå">
        <Description><![CDATA[<p>Blå komponent av RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="Rød referanse">
        <Description><![CDATA[<p>Rød referanseverdi for sammenligning</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="Grønn referanse">
        <Description><![CDATA[<p>Grønn referanseverdi for sammenligning</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="Blå referanse">
        <Description><![CDATA[<p>Blå referanseverdi for sammenligning</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="Toleranse">
        <Description><![CDATA[<p>Tillatt avvik per kanal for positivt treff</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="Treff">
        <Description><![CDATA[<p>Sant når målt RGB er innenfor toleransen</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="Fargetone">
        <Description><![CDATA[<p>Fargetonekomponent (0–360 grader)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="Metning">
        <Description><![CDATA[<p>Metningskomponent (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="Verdi">
        <Description><![CDATA[<p>Verdi/lysstyrke (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="Lyshet">
        <Description><![CDATA[<p>Lyshet (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="Mål – RGB-farge">
        <Description><![CDATA[<p>Les rå Rød-, Grønn- og Blå-verdier fra fargesensoren.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="Mål – HSVL-farge">
        <Description><![CDATA[<p>Les fargetone, metning, verdi og lyshet utledet fra sensorens RGB.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="Sammenlikn – RGB-farge">
        <Description><![CDATA[<p>Sammenlikne live RGB med en referansetrippel og returner en boolsk verdi.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="Fargeklassifiserer" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>Avstandsbaserte fargeklassifiseringsverktøy for fanen Dataoperasjoner.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="R-inngang">
        <Description><![CDATA[<p>Live rød kanalverdi til klassifisering</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="G-inngang">
        <Description><![CDATA[<p>Live grønn kanalverdi til klassifisering</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="B-inngang">
        <Description><![CDATA[<p>Live blå kanalverdi til klassifisering</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>Normalisert rød: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>Normalisert grønn: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>Normalisert blå: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="Referanse R">
        <Description><![CDATA[<p>Rød verdi for forhåndsdefinert farge som skal lagres</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="Referanse G">
        <Description><![CDATA[<p>Grønn verdi for forhåndsdefinert farge som skal lagres</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="Referanse B">
        <Description><![CDATA[<p>Blå verdi for forhåndsdefinert farge som skal lagres</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="Beste farge">
        <Description><![CDATA[<p>Indeks (1–8) for nærmeste forhåndsdefinerte farge</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="Beste avstand">
        <Description><![CDATA[<p>Avstand til nærmeste forhåndsdefinerte farge</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="Rød">
        <Description><![CDATA[<p>Squared distance from input RGB to Rød reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="Grønn">
        <Description><![CDATA[<p>Squared distance from input RGB to Grønn reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="Blå">
        <Description><![CDATA[<p>Squared distance from input RGB to Blå reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="Gul">
        <Description><![CDATA[<p>Squared distance from input RGB to Gul reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="Hvit">
        <Description><![CDATA[<p>Squared distance from input RGB to Hvit reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="Svart">
        <Description><![CDATA[<p>Squared distance from input RGB to Svart reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="Brun">
        <Description><![CDATA[<p>Squared distance from input RGB to Brun reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="Rosa">
        <Description><![CDATA[<p>Squared distance from input RGB to Rosa reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="Rød">
        <Description><![CDATA[<p>Distance to Rød (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="Grønn">
        <Description><![CDATA[<p>Distance to Grønn (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="Blå">
        <Description><![CDATA[<p>Distance to Blå (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="Gul">
        <Description><![CDATA[<p>Distance to Gul (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="Hvit">
        <Description><![CDATA[<p>Distance to Hvit (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="Svart">
        <Description><![CDATA[<p>Distance to Svart (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="Brun">
        <Description><![CDATA[<p>Distance to Brun (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="Rosa">
        <Description><![CDATA[<p>Distance to Rosa (from Distance mode)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="Normaliser – RGB">
        <Description><![CDATA[<p>Konverterer rå R, G, B til forhold (hver kanal delt på summen, × 100). Fjerner lysstyrkens innvirkning.</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="Oppsett">
        <Block Mode="Setup_Red" DisplayName="Sett opp Rød">
          <Description><![CDATA[<p>Lagre referanse-RGB for Rød (standard: R=255, G=0, B=0). Kall én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="Sett opp Grønn">
          <Description><![CDATA[<p>Lagre referanse-RGB for Grønn (standard: R=0, G=255, B=0). Kall én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="Sett opp Blå">
          <Description><![CDATA[<p>Lagre referanse-RGB for Blå (standard: R=0, G=0, B=255). Kall én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="Sett opp Gul">
          <Description><![CDATA[<p>Lagre referanse-RGB for Gul (standard: R=255, G=255, B=0). Kall én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="Sett opp Hvit">
          <Description><![CDATA[<p>Lagre referanse-RGB for Hvit (standard: R=255, G=255, B=255). Kall én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="Sett opp Svart">
          <Description><![CDATA[<p>Lagre referanse-RGB for Svart (standard: R=0, G=0, B=0). Kall én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="Sett opp Brun">
          <Description><![CDATA[<p>Lagre referanse-RGB for Brun (standard: R=128, G=64, B=0). Kall én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="Sett opp Rosa">
          <Description><![CDATA[<p>Lagre referanse-RGB for Rosa (standard: R=200, G=50, B=150). Kall én gang ved programstart.</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="Avstand">
        <Description><![CDATA[<p>Beregner den kvadrerte avstanden fra live RGB til hver av de 8 forhåndsdefinerte fargene. Koble utgangene til Identify-blokken.</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="Identifiser">
        <Description><![CDATA[<p>Tar de 8 avstandene fra Distance-blokken og returnerer indeksen (1–8) for nærmeste farge pluss faktisk avstand.</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>

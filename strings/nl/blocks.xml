<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="Kleursensor RGB Verbeterd" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="Poort">
        <Description><![CDATA[<p>Sensorpoort (1–4) van de EV3-kleursensor</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="Rood">
        <Description><![CDATA[<p>Roodcomponent van RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="Groen">
        <Description><![CDATA[<p>Groencomponent van RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="Blauw">
        <Description><![CDATA[<p>Blauwcomponent van RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="Referentie Rood">
        <Description><![CDATA[<p>Roodreferentiewaarde voor vergelijking</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="Referentie Groen">
        <Description><![CDATA[<p>Groenreferentiewaarde voor vergelijking</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="Referentie Blauw">
        <Description><![CDATA[<p>Blauwreferentiewaarde voor vergelijking</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="Tolerantie">
        <Description><![CDATA[<p>Toegestane afwijking per kanaal voor positieve match</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="Komt overeen">
        <Description><![CDATA[<p>Waar als gemeten RGB binnen tolerantie van referentie ligt</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="Tint">
        <Description><![CDATA[<p>Tintcomponent (0–360 graden)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="Verzadiging">
        <Description><![CDATA[<p>Verzadiging (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="Waarde">
        <Description><![CDATA[<p>Waarde/helderheid (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="Lichtheid">
        <Description><![CDATA[<p>Lichtheid (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="Meten – RGB-kleur">
        <Description><![CDATA[<p>Lees ruwe Rood-, Groen- en Blauwwaarden van de kleursensor.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="Meten – HSVL-kleur">
        <Description><![CDATA[<p>Lees tint, verzadiging, waarde en lichtheid afgeleid van de RGB van de sensor.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="Vergelijken – RGB-kleur">
        <Description><![CDATA[<p>Vergelijk live RGB met een referentietriplet en retourneer een boolean.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="Kleurclassificator" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>Op afstand gebaseerde kleurclassificatie-tools voor het tabblad Gegevensbewerkingen.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="R-ingang">
        <Description><![CDATA[<p>Live rode kanaalwaarde om te classificeren</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="G-ingang">
        <Description><![CDATA[<p>Live groene kanaalwaarde om te classificeren</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="B-ingang">
        <Description><![CDATA[<p>Live blauwe kanaalwaarde om te classificeren</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>Genormaliseerd rood: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>Genormaliseerd groen: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>Genormaliseerd blauw: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="Referentie R">
        <Description><![CDATA[<p>Rode waarde van de op te slaan voorkeurskleur</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="Referentie G">
        <Description><![CDATA[<p>Groene waarde van de op te slaan voorkeurskleur</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="Referentie B">
        <Description><![CDATA[<p>Blauwe waarde van de op te slaan voorkeurskleur</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Red" DisplayName="Rood inschakelen">
        <Description><![CDATA[<p>1 = Rood opnemen in classificatie, 0 = Rood negeren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Green" DisplayName="Groen inschakelen">
        <Description><![CDATA[<p>1 = Groen opnemen in classificatie, 0 = Groen negeren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Blue" DisplayName="Blauw inschakelen">
        <Description><![CDATA[<p>1 = Blauw opnemen in classificatie, 0 = Blauw negeren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Yellow" DisplayName="Geel inschakelen">
        <Description><![CDATA[<p>1 = Geel opnemen in classificatie, 0 = Geel negeren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_White" DisplayName="Wit inschakelen">
        <Description><![CDATA[<p>1 = Wit opnemen in classificatie, 0 = Wit negeren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Black" DisplayName="Zwart inschakelen">
        <Description><![CDATA[<p>1 = Zwart opnemen in classificatie, 0 = Zwart negeren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Brown" DisplayName="Bruin inschakelen">
        <Description><![CDATA[<p>1 = Bruin opnemen in classificatie, 0 = Bruin negeren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Pink" DisplayName="Roze inschakelen">
        <Description><![CDATA[<p>1 = Roze opnemen in classificatie, 0 = Roze negeren</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="Beste kleur">
        <Description><![CDATA[<p>Index (1–8) van de dichtstbijzijnde voorkeurskleur</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="Beste afstand">
        <Description><![CDATA[<p>Afstand tot de dichtstbijzijnde voorkeurskleur</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="Rood">
        <Description><![CDATA[<p>Kwadratische afstand van invoer-RGB naar Rood-referentie</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="Groen">
        <Description><![CDATA[<p>Kwadratische afstand van invoer-RGB naar Groen-referentie</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="Blauw">
        <Description><![CDATA[<p>Kwadratische afstand van invoer-RGB naar Blauw-referentie</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="Geel">
        <Description><![CDATA[<p>Kwadratische afstand van invoer-RGB naar Geel-referentie</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="Wit">
        <Description><![CDATA[<p>Kwadratische afstand van invoer-RGB naar Wit-referentie</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="Zwart">
        <Description><![CDATA[<p>Kwadratische afstand van invoer-RGB naar Zwart-referentie</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="Bruin">
        <Description><![CDATA[<p>Kwadratische afstand van invoer-RGB naar Bruin-referentie</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="Roze">
        <Description><![CDATA[<p>Kwadratische afstand van invoer-RGB naar Roze-referentie</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="Rood">
        <Description><![CDATA[<p>Afstand naar Rood (van Distance-modus)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="Groen">
        <Description><![CDATA[<p>Afstand naar Groen (van Distance-modus)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="Blauw">
        <Description><![CDATA[<p>Afstand naar Blauw (van Distance-modus)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="Geel">
        <Description><![CDATA[<p>Afstand naar Geel (van Distance-modus)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="Wit">
        <Description><![CDATA[<p>Afstand naar Wit (van Distance-modus)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="Zwart">
        <Description><![CDATA[<p>Afstand naar Zwart (van Distance-modus)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="Bruin">
        <Description><![CDATA[<p>Afstand naar Bruin (van Distance-modus)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="Roze">
        <Description><![CDATA[<p>Afstand naar Roze (van Distance-modus)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_R" DisplayName="R (Rood)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_G" DisplayName="G (Rood)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_B" DisplayName="B (Rood)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_R" DisplayName="R (Groen)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_G" DisplayName="G (Groen)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_B" DisplayName="B (Groen)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_R" DisplayName="R (Blauw)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_G" DisplayName="G (Blauw)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_B" DisplayName="B (Blauw)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_R" DisplayName="R (Geel)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_G" DisplayName="G (Geel)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_B" DisplayName="B (Geel)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_R" DisplayName="R (Wit)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_G" DisplayName="G (Wit)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_B" DisplayName="B (Wit)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_R" DisplayName="R (Zwart)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_G" DisplayName="G (Zwart)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_B" DisplayName="B (Zwart)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_R" DisplayName="R (Bruin)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_G" DisplayName="G (Bruin)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_B" DisplayName="B (Bruin)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_R" DisplayName="R (Roze)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_G" DisplayName="G (Roze)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_B" DisplayName="B (Roze)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="Normaliseren – RGB">
        <Description><![CDATA[<p>Converteert ruwe R, G, B naar verhoudingen (elk kanaal gedeeld door de som, × 100). Verwijdert helderheidsinvloed.</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="Instellen">
        <Block Mode="Setup_Red" DisplayName="Rood instellen">
          <Description><![CDATA[<p>Referentie-RGB opslaan voor Rood (standaard: R=255, G=0, B=0). Eén keer aanroepen bij programmastart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="Groen instellen">
          <Description><![CDATA[<p>Referentie-RGB opslaan voor Groen (standaard: R=0, G=255, B=0). Eén keer aanroepen bij programmastart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="Blauw instellen">
          <Description><![CDATA[<p>Referentie-RGB opslaan voor Blauw (standaard: R=0, G=0, B=255). Eén keer aanroepen bij programmastart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="Geel instellen">
          <Description><![CDATA[<p>Referentie-RGB opslaan voor Geel (standaard: R=255, G=255, B=0). Eén keer aanroepen bij programmastart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="Wit instellen">
          <Description><![CDATA[<p>Referentie-RGB opslaan voor Wit (standaard: R=255, G=255, B=255). Eén keer aanroepen bij programmastart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="Zwart instellen">
          <Description><![CDATA[<p>Referentie-RGB opslaan voor Zwart (standaard: R=0, G=0, B=0). Eén keer aanroepen bij programmastart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="Bruin instellen">
          <Description><![CDATA[<p>Referentie-RGB opslaan voor Bruin (standaard: R=128, G=64, B=0). Eén keer aanroepen bij programmastart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="Roze instellen">
          <Description><![CDATA[<p>Referentie-RGB opslaan voor Roze (standaard: R=200, G=50, B=150). Eén keer aanroepen bij programmastart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Enable" DisplayName="Kleuren inschakelen">
          <Description><![CDATA[<p>Stelt in welke kleuren actief zijn (1=aan, 0=uit). Uitgeschakelde kleuren geven afstand 999999 en worden nooit gekozen door Identify.</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="Afstand">
        <Description><![CDATA[<p>Berekent de kwadratische afstand van live RGB tot elk van de 8 voorkeurskleuren. Bedraad de uitgangen naar het Identify-blok.</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="Identificeren">
        <Description><![CDATA[<p>Neemt de 8 afstanden van het Distance-blok en retourneert de index (1–8) van de dichtstbijzijnde kleur plus de werkelijke afstand.</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>

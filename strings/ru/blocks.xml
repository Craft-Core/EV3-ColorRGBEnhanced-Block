<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="Датчик цвета RGB расширенный" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="Порт">
        <Description><![CDATA[<p>Порт датчика (1–4) цветного датчика EV3</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="Красный">
        <Description><![CDATA[<p>Красная компонента RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="Зелёный">
        <Description><![CDATA[<p>Зелёная компонента RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="Синий">
        <Description><![CDATA[<p>Синяя компонента RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="Опорное R">
        <Description><![CDATA[<p>Опорное значение красного для сравнения</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="Опорное G">
        <Description><![CDATA[<p>Опорное значение зелёного для сравнения</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="Опорное B">
        <Description><![CDATA[<p>Опорное значение синего для сравнения</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="Допуск">
        <Description><![CDATA[<p>Допустимое отклонение по каналу для совпадения</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="Совпадение">
        <Description><![CDATA[<p>Истина, если RGB в пределах допуска</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="Оттенок">
        <Description><![CDATA[<p>Компонента оттенка (0–360 град.)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="Насыщенность">
        <Description><![CDATA[<p>Насыщенность (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="Яркость">
        <Description><![CDATA[<p>Яркость (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="Светлота">
        <Description><![CDATA[<p>Светлота (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="Измерить – цвет RGB">
        <Description><![CDATA[<p>Читает сырые R, G, B с датчика цвета.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="Измерить – цвет HSVL">
        <Description><![CDATA[<p>Читает H, S, V, L, вычисленные из RGB датчика.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="Сравнить – цвет RGB">
        <Description><![CDATA[<p>Сравнивает RGB с опорным и возвращает булево значение.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="Классификатор цвета" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>Инструменты классификации по расстоянию для вкладки 'Операции с данными'.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="R вход">
        <Description><![CDATA[<p>Текущее значение красного</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="G вход">
        <Description><![CDATA[<p>Текущее значение зелёного</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="B вход">
        <Description><![CDATA[<p>Текущее значение синего</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>Нормированный R: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>Нормированный G: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>Нормированный B: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="Опорное R">
        <Description><![CDATA[<p>Красное значение сохраняемого цвета</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="Опорное G">
        <Description><![CDATA[<p>Зелёное значение сохраняемого цвета</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="Опорное B">
        <Description><![CDATA[<p>Синее значение сохраняемого цвета</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Red" DisplayName="Вкл. Красный">
        <Description><![CDATA[<p>1 = включить Красный в классификацию, 0 = игнорировать Красный</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Green" DisplayName="Вкл. Зелёный">
        <Description><![CDATA[<p>1 = включить Зелёный в классификацию, 0 = игнорировать Зелёный</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Blue" DisplayName="Вкл. Синий">
        <Description><![CDATA[<p>1 = включить Синий в классификацию, 0 = игнорировать Синий</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Yellow" DisplayName="Вкл. Жёлтый">
        <Description><![CDATA[<p>1 = включить Жёлтый в классификацию, 0 = игнорировать Жёлтый</p>]]></Description>
      </Parameter>
      <Parameter Name="En_White" DisplayName="Вкл. Белый">
        <Description><![CDATA[<p>1 = включить Белый в классификацию, 0 = игнорировать Белый</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Black" DisplayName="Вкл. Чёрный">
        <Description><![CDATA[<p>1 = включить Чёрный в классификацию, 0 = игнорировать Чёрный</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Brown" DisplayName="Вкл. Коричневый">
        <Description><![CDATA[<p>1 = включить Коричневый в классификацию, 0 = игнорировать Коричневый</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Pink" DisplayName="Вкл. Розовый">
        <Description><![CDATA[<p>1 = включить Розовый в классификацию, 0 = игнорировать Розовый</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="Лучший цвет">
        <Description><![CDATA[<p>Номер (1–8) ближайшего цвета</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="Лучшее расстояние">
        <Description><![CDATA[<p>Расстояние до ближайшего цвета</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="Красный">
        <Description><![CDATA[<p>Squared distance from input RGB to Красный reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="Зелёный">
        <Description><![CDATA[<p>Squared distance from input RGB to Зелёный reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="Синий">
        <Description><![CDATA[<p>Squared distance from input RGB to Синий reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="Жёлтый">
        <Description><![CDATA[<p>Squared distance from input RGB to Жёлтый reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="Белый">
        <Description><![CDATA[<p>Squared distance from input RGB to Белый reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="Чёрный">
        <Description><![CDATA[<p>Squared distance from input RGB to Чёрный reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="Коричневый">
        <Description><![CDATA[<p>Squared distance from input RGB to Коричневый reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="Розовый">
        <Description><![CDATA[<p>Squared distance from input RGB to Розовый reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="Красный">
        <Description><![CDATA[<p>Distance to Красный (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="Зелёный">
        <Description><![CDATA[<p>Distance to Зелёный (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="Синий">
        <Description><![CDATA[<p>Distance to Синий (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="Жёлтый">
        <Description><![CDATA[<p>Distance to Жёлтый (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="Белый">
        <Description><![CDATA[<p>Distance to Белый (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="Чёрный">
        <Description><![CDATA[<p>Distance to Чёрный (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="Коричневый">
        <Description><![CDATA[<p>Distance to Коричневый (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="Розовый">
        <Description><![CDATA[<p>Distance to Розовый (from Distance mode)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="Нормализация – RGB">
        <Description><![CDATA[<p>Преобразует сырые R, G, B в доли (канал/сумма, ×100). Убирает влияние яркости.</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="Настройка">
        <Block Mode="Setup_Red" DisplayName="Настроить Красный">
          <Description><![CDATA[<p>Сохранить эталонный RGB для Красный (по умолчанию: R=255, G=0, B=0). Вызвать один раз в начале программы.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="Настроить Зелёный">
          <Description><![CDATA[<p>Сохранить эталонный RGB для Зелёный (по умолчанию: R=0, G=255, B=0). Вызвать один раз в начале программы.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="Настроить Синий">
          <Description><![CDATA[<p>Сохранить эталонный RGB для Синий (по умолчанию: R=0, G=0, B=255). Вызвать один раз в начале программы.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="Настроить Жёлтый">
          <Description><![CDATA[<p>Сохранить эталонный RGB для Жёлтый (по умолчанию: R=255, G=255, B=0). Вызвать один раз в начале программы.</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="Настроить Белый">
          <Description><![CDATA[<p>Сохранить эталонный RGB для Белый (по умолчанию: R=255, G=255, B=255). Вызвать один раз в начале программы.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="Настроить Чёрный">
          <Description><![CDATA[<p>Сохранить эталонный RGB для Чёрный (по умолчанию: R=0, G=0, B=0). Вызвать один раз в начале программы.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="Настроить Коричневый">
          <Description><![CDATA[<p>Сохранить эталонный RGB для Коричневый (по умолчанию: R=128, G=64, B=0). Вызвать один раз в начале программы.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="Настроить Розовый">
          <Description><![CDATA[<p>Сохранить эталонный RGB для Розовый (по умолчанию: R=200, G=50, B=150). Вызвать один раз в начале программы.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Enable" DisplayName="Включить цвета">
          <Description><![CDATA[<p>Задаёт активные цвета (1=вкл, 0=выкл). Отключённые цвета выдают расстояние 999999 и никогда не выбираются Identify.</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="Расстояние">
        <Description><![CDATA[<p>Вычисляет квадрат расстояния от RGB до каждого из 8 цветов. Подключите выходы к Identify.</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="Идентификация">
        <Description><![CDATA[<p>Принимает 8 расстояний от блока Distance и возвращает номер (1–8) ближайшего цвета и расстояние до него.</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>

<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="Farbsensor RGB Erweitert" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="Port">
        <Description><![CDATA[<p>Sensorport (1–4) des EV3-Farbsensors</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="Rot">
        <Description><![CDATA[<p>Rote Komponente des RGB-Werts (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="Grün">
        <Description><![CDATA[<p>Grüne Komponente des RGB-Werts (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="Blau">
        <Description><![CDATA[<p>Blaue Komponente des RGB-Werts (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="Referenz Rot">
        <Description><![CDATA[<p>Referenzwert für Rot</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="Referenz Grün">
        <Description><![CDATA[<p>Referenzwert für Grün</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="Referenz Blau">
        <Description><![CDATA[<p>Referenzwert für Blau</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="Toleranz">
        <Description><![CDATA[<p>Zulässige Abweichung pro Kanal für Treffer</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="Treffer">
        <Description><![CDATA[<p>Wahr, wenn RGB innerhalb der Toleranz zur Referenz liegt</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="Farbton">
        <Description><![CDATA[<p>Farbton (0–360 Grad)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="Sättigung">
        <Description><![CDATA[<p>Sättigung (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="Wert">
        <Description><![CDATA[<p>Helligkeitswert (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="Helligkeit">
        <Description><![CDATA[<p>Helligkeit (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="Messen – RGB-Farbe">
        <Description><![CDATA[<p>Rohe Rot-, Grün- und Blauwerte vom Farbsensor lesen.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="Messen – HSVL-Farbe">
        <Description><![CDATA[<p>Farbton, Sättigung, Wert und Helligkeit aus dem RGB-Wert berechnen.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="Vergleichen – RGB-Farbe">
        <Description><![CDATA[<p>Live-RGB mit einem Referenz-Triple vergleichen, gibt Boolean zurück.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="Farb-Klassifikator" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>Distanzbasierte Farbklassifikation für den Tab „Datenoperationen“.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="R-Eingang">
        <Description><![CDATA[<p>Lebender Rotwert zur Klassifizierung</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="G-Eingang">
        <Description><![CDATA[<p>Lebender Grünwert zur Klassifizierung</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="B-Eingang">
        <Description><![CDATA[<p>Lebender Blauwert zur Klassifizierung</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>Normiertes Rot: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>Normiertes Grün: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>Normiertes Blau: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="Referenz R">
        <Description><![CDATA[<p>Roter Wert der zu speichernden Voreinstellungsfarbe</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="Referenz G">
        <Description><![CDATA[<p>Grüner Wert der zu speichernden Voreinstellungsfarbe</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="Referenz B">
        <Description><![CDATA[<p>Blauer Wert der zu speichernden Voreinstellungsfarbe</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Red" DisplayName="Rot aktivieren">
        <Description><![CDATA[<p>1 = Rot klassifizieren, 0 = Rot ignorieren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Green" DisplayName="Grün aktivieren">
        <Description><![CDATA[<p>1 = Grün klassifizieren, 0 = Grün ignorieren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Blue" DisplayName="Blau aktivieren">
        <Description><![CDATA[<p>1 = Blau klassifizieren, 0 = Blau ignorieren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Yellow" DisplayName="Gelb aktivieren">
        <Description><![CDATA[<p>1 = Gelb klassifizieren, 0 = Gelb ignorieren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_White" DisplayName="Weiß aktivieren">
        <Description><![CDATA[<p>1 = Weiß klassifizieren, 0 = Weiß ignorieren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Black" DisplayName="Schwarz aktivieren">
        <Description><![CDATA[<p>1 = Schwarz klassifizieren, 0 = Schwarz ignorieren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Brown" DisplayName="Braun aktivieren">
        <Description><![CDATA[<p>1 = Braun klassifizieren, 0 = Braun ignorieren</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Pink" DisplayName="Rosa aktivieren">
        <Description><![CDATA[<p>1 = Rosa klassifizieren, 0 = Rosa ignorieren</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="Beste Farbe">
        <Description><![CDATA[<p>Index (1–8) der nächstgelegenen Voreinstellungsfarbe</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="Beste Distanz">
        <Description><![CDATA[<p>Distanz zur nächstgelegenen Voreinstellungsfarbe</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="Rot">
        <Description><![CDATA[<p>Quadrierte Distanz vom Eingangs-RGB zur Rot-Referenz</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="Grün">
        <Description><![CDATA[<p>Quadrierte Distanz vom Eingangs-RGB zur Grün-Referenz</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="Blau">
        <Description><![CDATA[<p>Quadrierte Distanz vom Eingangs-RGB zur Blau-Referenz</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="Gelb">
        <Description><![CDATA[<p>Quadrierte Distanz vom Eingangs-RGB zur Gelb-Referenz</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="Weiß">
        <Description><![CDATA[<p>Quadrierte Distanz vom Eingangs-RGB zur Weiß-Referenz</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="Schwarz">
        <Description><![CDATA[<p>Quadrierte Distanz vom Eingangs-RGB zur Schwarz-Referenz</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="Braun">
        <Description><![CDATA[<p>Quadrierte Distanz vom Eingangs-RGB zur Braun-Referenz</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="Rosa">
        <Description><![CDATA[<p>Quadrierte Distanz vom Eingangs-RGB zur Rosa-Referenz</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="Rot">
        <Description><![CDATA[<p>Distanz zu Rot (vom Distance-Block)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="Grün">
        <Description><![CDATA[<p>Distanz zu Grün (vom Distance-Block)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="Blau">
        <Description><![CDATA[<p>Distanz zu Blau (vom Distance-Block)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="Gelb">
        <Description><![CDATA[<p>Distanz zu Gelb (vom Distance-Block)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="Weiß">
        <Description><![CDATA[<p>Distanz zu Weiß (vom Distance-Block)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="Schwarz">
        <Description><![CDATA[<p>Distanz zu Schwarz (vom Distance-Block)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="Braun">
        <Description><![CDATA[<p>Distanz zu Braun (vom Distance-Block)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="Rosa">
        <Description><![CDATA[<p>Distanz zu Rosa (vom Distance-Block)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_R" DisplayName="R (Rot)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_G" DisplayName="G (Rot)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_B" DisplayName="B (Rot)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_R" DisplayName="R (Grün)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_G" DisplayName="G (Grün)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_B" DisplayName="B (Grün)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_R" DisplayName="R (Blau)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_G" DisplayName="G (Blau)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_B" DisplayName="B (Blau)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_R" DisplayName="R (Gelb)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_G" DisplayName="G (Gelb)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_B" DisplayName="B (Gelb)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_R" DisplayName="R (Weiß)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_G" DisplayName="G (Weiß)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_B" DisplayName="B (Weiß)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_R" DisplayName="R (Schwarz)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_G" DisplayName="G (Schwarz)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_B" DisplayName="B (Schwarz)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_R" DisplayName="R (Braun)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_G" DisplayName="G (Braun)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_B" DisplayName="B (Braun)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_R" DisplayName="R (Pink)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_G" DisplayName="G (Pink)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_B" DisplayName="B (Pink)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="Normieren – RGB">
        <Description><![CDATA[<p>Wandelt rohe R, G, B in Verhältnisse (jeder Kanal geteilt durch die Summe, mal 100). Entfernt Helligkeitseinfluss, behält nur die Farbe.</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="Einrichten">
        <Block Mode="Setup_Red" DisplayName="Rot einrichten">
          <Description><![CDATA[<p>Referenz-RGB für Rot speichern (Standard: R=255, G=0, B=0). Einmal beim Programmstart aufrufen.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="Grün einrichten">
          <Description><![CDATA[<p>Referenz-RGB für Grün speichern (Standard: R=0, G=255, B=0). Einmal beim Programmstart aufrufen.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="Blau einrichten">
          <Description><![CDATA[<p>Referenz-RGB für Blau speichern (Standard: R=0, G=0, B=255). Einmal beim Programmstart aufrufen.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="Gelb einrichten">
          <Description><![CDATA[<p>Referenz-RGB für Gelb speichern (Standard: R=255, G=255, B=0). Einmal beim Programmstart aufrufen.</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="Weiß einrichten">
          <Description><![CDATA[<p>Referenz-RGB für Weiß speichern (Standard: R=255, G=255, B=255). Einmal beim Programmstart aufrufen.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="Schwarz einrichten">
          <Description><![CDATA[<p>Referenz-RGB für Schwarz speichern (Standard: R=0, G=0, B=0). Einmal beim Programmstart aufrufen.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="Braun einrichten">
          <Description><![CDATA[<p>Referenz-RGB für Braun speichern (Standard: R=128, G=64, B=0). Einmal beim Programmstart aufrufen.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="Rosa einrichten">
          <Description><![CDATA[<p>Referenz-RGB für Rosa speichern (Standard: R=200, G=50, B=150). Einmal beim Programmstart aufrufen.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Enable" DisplayName="Farben aktivieren">
          <Description><![CDATA[<p>Legt fest, welche Farben aktiv sind (1=an, 0=aus). Deaktivierte Farben liefern Distanz 999999 und werden von Identify nie gewählt.</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="Distanz">
        <Description><![CDATA[<p>Berechnet die quadrierte Distanz vom Live-RGB zu jeder der 8 Voreinstellungsfarben. Ausgänge in den Identify-Block verdrahten.</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="Identifizieren">
        <Description><![CDATA[<p>Nimmt die 8 Distanzen vom Distance-Block und gibt den Index (1–8) der nächstgelegenen Farbe plus die tatsächliche Distanz zurück.</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>

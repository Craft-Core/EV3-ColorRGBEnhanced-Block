<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="Sensor de color RGB mejorado" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="Puerto">
        <Description><![CDATA[<p>Puerto del sensor (1–4) del sensor de color EV3</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="Rojo">
        <Description><![CDATA[<p>Componente rojo del RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="Verde">
        <Description><![CDATA[<p>Componente verde del RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="Azul">
        <Description><![CDATA[<p>Componente azul del RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="Referencia rojo">
        <Description><![CDATA[<p>Valor rojo de referencia para comparar</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="Referencia verde">
        <Description><![CDATA[<p>Valor verde de referencia para comparar</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="Referencia azul">
        <Description><![CDATA[<p>Valor azul de referencia para comparar</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="Tolerancia">
        <Description><![CDATA[<p>Desviación permitida por canal para coincidencia positiva</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="Coincide">
        <Description><![CDATA[<p>Verdadero si el RGB medido está dentro de la tolerancia</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="Tono">
        <Description><![CDATA[<p>Componente tono (0–360 grados)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="Saturación">
        <Description><![CDATA[<p>Componente saturación (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="Valor">
        <Description><![CDATA[<p>Valor/brillo (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="Luminosidad">
        <Description><![CDATA[<p>Luminosidad (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="Medir – color RGB">
        <Description><![CDATA[<p>Leer valores brutos Rojo, Verde y Azul del sensor de color.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="Medir – color HSVL">
        <Description><![CDATA[<p>Leer tono, saturación, valor y luminosidad derivados del RGB del sensor.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="Comparar – color RGB">
        <Description><![CDATA[<p>Comparar el RGB en vivo con un triple de referencia y devolver un booleano.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="Clasificador de color" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>Utilidades de clasificación de color basadas en distancia para la pestaña Operaciones de datos.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="Entrada R">
        <Description><![CDATA[<p>Valor rojo en vivo a clasificar</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="Entrada G">
        <Description><![CDATA[<p>Valor verde en vivo a clasificar</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="Entrada B">
        <Description><![CDATA[<p>Valor azul en vivo a clasificar</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>Rojo normalizado: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>Verde normalizado: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>Azul normalizado: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="Referencia R">
        <Description><![CDATA[<p>Valor rojo del color predefinido a guardar</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="Referencia G">
        <Description><![CDATA[<p>Valor verde del color predefinido a guardar</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="Referencia B">
        <Description><![CDATA[<p>Valor azul del color predefinido a guardar</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Red" DisplayName="Activar Rojo">
        <Description><![CDATA[<p>1 = incluir Rojo en la clasificación, 0 = ignorar Rojo</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Green" DisplayName="Activar Verde">
        <Description><![CDATA[<p>1 = incluir Verde en la clasificación, 0 = ignorar Verde</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Blue" DisplayName="Activar Azul">
        <Description><![CDATA[<p>1 = incluir Azul en la clasificación, 0 = ignorar Azul</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Yellow" DisplayName="Activar Amarillo">
        <Description><![CDATA[<p>1 = incluir Amarillo en la clasificación, 0 = ignorar Amarillo</p>]]></Description>
      </Parameter>
      <Parameter Name="En_White" DisplayName="Activar Blanco">
        <Description><![CDATA[<p>1 = incluir Blanco en la clasificación, 0 = ignorar Blanco</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Black" DisplayName="Activar Negro">
        <Description><![CDATA[<p>1 = incluir Negro en la clasificación, 0 = ignorar Negro</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Brown" DisplayName="Activar Marrón">
        <Description><![CDATA[<p>1 = incluir Marrón en la clasificación, 0 = ignorar Marrón</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Pink" DisplayName="Activar Rosa">
        <Description><![CDATA[<p>1 = incluir Rosa en la clasificación, 0 = ignorar Rosa</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="Mejor color">
        <Description><![CDATA[<p>Índice (1–8) del color predefinido más cercano</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="Mejor distancia">
        <Description><![CDATA[<p>Distancia al color más cercano</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="Rojo">
        <Description><![CDATA[<p>Distancia cuadrada del RGB de entrada a la referencia de Rojo</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="Verde">
        <Description><![CDATA[<p>Distancia cuadrada del RGB de entrada a la referencia de Verde</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="Azul">
        <Description><![CDATA[<p>Distancia cuadrada del RGB de entrada a la referencia de Azul</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="Amarillo">
        <Description><![CDATA[<p>Distancia cuadrada del RGB de entrada a la referencia de Amarillo</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="Blanco">
        <Description><![CDATA[<p>Distancia cuadrada del RGB de entrada a la referencia de Blanco</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="Negro">
        <Description><![CDATA[<p>Distancia cuadrada del RGB de entrada a la referencia de Negro</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="Marrón">
        <Description><![CDATA[<p>Distancia cuadrada del RGB de entrada a la referencia de Marrón</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="Rosa">
        <Description><![CDATA[<p>Distancia cuadrada del RGB de entrada a la referencia de Rosa</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="Rojo">
        <Description><![CDATA[<p>Distancia a Rojo (del modo Distancia)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="Verde">
        <Description><![CDATA[<p>Distancia a Verde (del modo Distancia)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="Azul">
        <Description><![CDATA[<p>Distancia a Azul (del modo Distancia)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="Amarillo">
        <Description><![CDATA[<p>Distancia a Amarillo (del modo Distancia)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="Blanco">
        <Description><![CDATA[<p>Distancia a Blanco (del modo Distancia)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="Negro">
        <Description><![CDATA[<p>Distancia a Negro (del modo Distancia)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="Marrón">
        <Description><![CDATA[<p>Distancia a Marrón (del modo Distancia)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="Rosa">
        <Description><![CDATA[<p>Distancia a Rosa (del modo Distancia)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_R" DisplayName="R (Rojo)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_G" DisplayName="G (Rojo)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_B" DisplayName="B (Rojo)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_R" DisplayName="R (Verde)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_G" DisplayName="G (Verde)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_B" DisplayName="B (Verde)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_R" DisplayName="R (Azul)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_G" DisplayName="G (Azul)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_B" DisplayName="B (Azul)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_R" DisplayName="R (Amarillo)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_G" DisplayName="G (Amarillo)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_B" DisplayName="B (Amarillo)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_R" DisplayName="R (Blanco)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_G" DisplayName="G (Blanco)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_B" DisplayName="B (Blanco)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_R" DisplayName="R (Negro)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_G" DisplayName="G (Negro)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_B" DisplayName="B (Negro)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_R" DisplayName="R (Marrón)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_G" DisplayName="G (Marrón)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_B" DisplayName="B (Marrón)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_R" DisplayName="R (Rosa)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_G" DisplayName="G (Rosa)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_B" DisplayName="B (Rosa)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="Normalizar – RGB">
        <Description><![CDATA[<p>Convierte R, G, B brutos en proporciones (cada canal dividido por la suma, × 100). Elimina la influencia del brillo y mantiene solo el color.</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="Configurar">
        <Block Mode="Setup_Red" DisplayName="Configurar Rojo">
          <Description><![CDATA[<p>Guardar el RGB de referencia para Rojo (predeterminado: R=255, G=0, B=0). Llamar una vez al inicio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="Configurar Verde">
          <Description><![CDATA[<p>Guardar el RGB de referencia para Verde (predeterminado: R=0, G=255, B=0). Llamar una vez al inicio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="Configurar Azul">
          <Description><![CDATA[<p>Guardar el RGB de referencia para Azul (predeterminado: R=0, G=0, B=255). Llamar una vez al inicio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="Configurar Amarillo">
          <Description><![CDATA[<p>Guardar el RGB de referencia para Amarillo (predeterminado: R=255, G=255, B=0). Llamar una vez al inicio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="Configurar Blanco">
          <Description><![CDATA[<p>Guardar el RGB de referencia para Blanco (predeterminado: R=255, G=255, B=255). Llamar una vez al inicio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="Configurar Negro">
          <Description><![CDATA[<p>Guardar el RGB de referencia para Negro (predeterminado: R=0, G=0, B=0). Llamar una vez al inicio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="Configurar Marrón">
          <Description><![CDATA[<p>Guardar el RGB de referencia para Marrón (predeterminado: R=128, G=64, B=0). Llamar una vez al inicio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="Configurar Rosa">
          <Description><![CDATA[<p>Guardar el RGB de referencia para Rosa (predeterminado: R=200, G=50, B=150). Llamar una vez al inicio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Enable" DisplayName="Activar colores">
          <Description><![CDATA[<p>Establece qué colores están activos (1=sí, 0=no). Los colores desactivados dan distancia 999999 y Identify nunca los elige.</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="Distancia">
        <Description><![CDATA[<p>Calcula la distancia al cuadrado del RGB en vivo a cada uno de los 8 colores predefinidos. Conectar las salidas al bloque Identificar.</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="Identificar">
        <Description><![CDATA[<p>Toma las 8 distancias del bloque Distancia y devuelve el índice (1–8) del color más cercano y la distancia real.</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>

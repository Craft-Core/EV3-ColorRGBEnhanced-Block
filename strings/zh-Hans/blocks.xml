<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="颜色传感器 RGB 增强版" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="端口">
        <Description><![CDATA[<p>EV3 颜色传感器连接的端口 (1–4)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="红">
        <Description><![CDATA[<p>RGB 中的红色分量 (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="绿">
        <Description><![CDATA[<p>RGB 中的绿色分量 (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="蓝">
        <Description><![CDATA[<p>RGB 中的蓝色分量 (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="红色参考值">
        <Description><![CDATA[<p>用于对比的红色参考值</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="绿色参考值">
        <Description><![CDATA[<p>用于对比的绿色参考值</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="蓝色参考值">
        <Description><![CDATA[<p>用于对比的蓝色参考值</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="允许误差">
        <Description><![CDATA[<p>认为匹配成功的每通道允许偏差</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="匹配">
        <Description><![CDATA[<p>实测 RGB 在误差范围内返回真</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="色调">
        <Description><![CDATA[<p>色调 (0–360 度)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="饱和度">
        <Description><![CDATA[<p>饱和度 (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="明度值">
        <Description><![CDATA[<p>明度/亮度 (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="亮度">
        <Description><![CDATA[<p>亮度 (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="测量 – RGB 颜色">
        <Description><![CDATA[<p>从颜色传感器读取原始的红、绿、蓝值。</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="测量 – HSVL 颜色">
        <Description><![CDATA[<p>从传感器的 RGB 推导并读取色调、饱和度、明度和亮度。</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="比较 – RGB 颜色">
        <Description><![CDATA[<p>将实时 RGB 与参考三元组比较并返回布尔值。</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="颜色分类器" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>“数据操作”选项卡中的基于距离的颜色分类实用工具。</p>]]></Description>
      <Parameter Name="R_in" DisplayName="R 输入">
        <Description><![CDATA[<p>需要分类的实时红色值</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="G 输入">
        <Description><![CDATA[<p>需要分类的实时绿色值</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="B 输入">
        <Description><![CDATA[<p>需要分类的实时蓝色值</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>归一化的红: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>归一化的绿: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>归一化的蓝: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="参考 R">
        <Description><![CDATA[<p>要保存的预设颜色的红值</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="参考 G">
        <Description><![CDATA[<p>要保存的预设颜色的绿值</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="参考 B">
        <Description><![CDATA[<p>要保存的预设颜色的蓝值</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="最佳颜色">
        <Description><![CDATA[<p>最接近的预设颜色的编号 (1–8)</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="最佳距离">
        <Description><![CDATA[<p>到最接近颜色的距离</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="红">
        <Description><![CDATA[<p>Squared distance from input RGB to 红 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="绿">
        <Description><![CDATA[<p>Squared distance from input RGB to 绿 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="蓝">
        <Description><![CDATA[<p>Squared distance from input RGB to 蓝 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="黄">
        <Description><![CDATA[<p>Squared distance from input RGB to 黄 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="白">
        <Description><![CDATA[<p>Squared distance from input RGB to 白 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="黑">
        <Description><![CDATA[<p>Squared distance from input RGB to 黑 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="棕">
        <Description><![CDATA[<p>Squared distance from input RGB to 棕 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="粉">
        <Description><![CDATA[<p>Squared distance from input RGB to 粉 reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="红">
        <Description><![CDATA[<p>Distance to 红 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="绿">
        <Description><![CDATA[<p>Distance to 绿 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="蓝">
        <Description><![CDATA[<p>Distance to 蓝 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="黄">
        <Description><![CDATA[<p>Distance to 黄 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="白">
        <Description><![CDATA[<p>Distance to 白 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="黑">
        <Description><![CDATA[<p>Distance to 黑 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="棕">
        <Description><![CDATA[<p>Distance to 棕 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="粉">
        <Description><![CDATA[<p>Distance to 粉 (from Distance mode)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="归一化 – RGB">
        <Description><![CDATA[<p>将原始 R、G、B 转换为比例（每个通道除以总和，乘 100）。消除亮度影响，只保留颜色信息。</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="设置">
        <Block Mode="Setup_Red" DisplayName="设置红">
          <Description><![CDATA[<p>保存红的参考 RGB（默认：R=255，G=0，B=0）。在程序开始时调用一次。</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="设置绿">
          <Description><![CDATA[<p>保存绿的参考 RGB（默认：R=0，G=255，B=0）。在程序开始时调用一次。</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="设置蓝">
          <Description><![CDATA[<p>保存蓝的参考 RGB（默认：R=0，G=0，B=255）。在程序开始时调用一次。</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="设置黄">
          <Description><![CDATA[<p>保存黄的参考 RGB（默认：R=255，G=255，B=0）。在程序开始时调用一次。</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="设置白">
          <Description><![CDATA[<p>保存白的参考 RGB（默认：R=255，G=255，B=255）。在程序开始时调用一次。</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="设置黑">
          <Description><![CDATA[<p>保存黑的参考 RGB（默认：R=0，G=0，B=0）。在程序开始时调用一次。</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="设置棕">
          <Description><![CDATA[<p>保存棕的参考 RGB（默认：R=128，G=64，B=0）。在程序开始时调用一次。</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="设置粉">
          <Description><![CDATA[<p>保存粉的参考 RGB（默认：R=200，G=50，B=150）。在程序开始时调用一次。</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="距离">
        <Description><![CDATA[<p>计算实时 RGB 到 8 个预设颜色中每个的平方距离。将输出连接到 Identify 模块。</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="识别">
        <Description><![CDATA[<p>接收 Distance 模块的 8 个距离，返回最接近颜色的编号 (1–8) 和实际距离。</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>

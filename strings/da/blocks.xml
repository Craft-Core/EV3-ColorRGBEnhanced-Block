<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="Farvesensor RGB Udvidet" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="Port">
        <Description><![CDATA[<p>Sensorport (1–4) for EV3-farvesensoren</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="Rød">
        <Description><![CDATA[<p>Rød komponent af RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="Grøn">
        <Description><![CDATA[<p>Grøn komponent af RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="Blå">
        <Description><![CDATA[<p>Blå komponent af RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="Rød reference">
        <Description><![CDATA[<p>Rød referenceværdi til sammenligning</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="Grøn reference">
        <Description><![CDATA[<p>Grøn referenceværdi til sammenligning</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="Blå reference">
        <Description><![CDATA[<p>Blå referenceværdi til sammenligning</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="Tolerance">
        <Description><![CDATA[<p>Tilladt afvigelse pr. kanal for positivt match</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="Match">
        <Description><![CDATA[<p>Sand når målt RGB er inden for tolerance</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="Farvetone">
        <Description><![CDATA[<p>Farvetonekomponent (0–360 grader)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="Mætning">
        <Description><![CDATA[<p>Mætningskomponent (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="Værdi">
        <Description><![CDATA[<p>Værdi/lysstyrke (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="Lyshed">
        <Description><![CDATA[<p>Lyshed (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="Mål – RGB-farve">
        <Description><![CDATA[<p>Læs rå Rød-, Grøn- og Blå-værdier fra farvesensoren.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="Mål – HSVL-farve">
        <Description><![CDATA[<p>Læs farvetone, mætning, værdi og lyshed beregnet fra sensorens RGB.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="Sammenlign – RGB-farve">
        <Description><![CDATA[<p>Sammenlign live RGB med en referencetripel og returner en boolsk værdi.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="Farveklassificering" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>Afstandsbaserede farveklassificeringsværktøjer til fanen Datahandlinger.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="R-indgang">
        <Description><![CDATA[<p>Live rød kanalværdi til klassificering</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="G-indgang">
        <Description><![CDATA[<p>Live grøn kanalværdi til klassificering</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="B-indgang">
        <Description><![CDATA[<p>Live blå kanalværdi til klassificering</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>Normaliseret rød: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>Normaliseret grøn: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>Normaliseret blå: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="Reference R">
        <Description><![CDATA[<p>Rød værdi af den forudindstillede farve, der skal gemmes</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="Reference G">
        <Description><![CDATA[<p>Grøn værdi af den forudindstillede farve, der skal gemmes</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="Reference B">
        <Description><![CDATA[<p>Blå værdi af den forudindstillede farve, der skal gemmes</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Red" DisplayName="Aktiver Rød">
        <Description><![CDATA[<p>1 = inkluder Rød i klassifikation, 0 = ignorer Rød</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Green" DisplayName="Aktiver Grøn">
        <Description><![CDATA[<p>1 = inkluder Grøn i klassifikation, 0 = ignorer Grøn</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Blue" DisplayName="Aktiver Blå">
        <Description><![CDATA[<p>1 = inkluder Blå i klassifikation, 0 = ignorer Blå</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Yellow" DisplayName="Aktiver Gul">
        <Description><![CDATA[<p>1 = inkluder Gul i klassifikation, 0 = ignorer Gul</p>]]></Description>
      </Parameter>
      <Parameter Name="En_White" DisplayName="Aktiver Hvid">
        <Description><![CDATA[<p>1 = inkluder Hvid i klassifikation, 0 = ignorer Hvid</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Black" DisplayName="Aktiver Sort">
        <Description><![CDATA[<p>1 = inkluder Sort i klassifikation, 0 = ignorer Sort</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Brown" DisplayName="Aktiver Brun">
        <Description><![CDATA[<p>1 = inkluder Brun i klassifikation, 0 = ignorer Brun</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Pink" DisplayName="Aktiver Pink">
        <Description><![CDATA[<p>1 = inkluder Pink i klassifikation, 0 = ignorer Pink</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="Bedste farve">
        <Description><![CDATA[<p>Indeks (1–8) for den nærmeste forudindstillede farve</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="Bedste afstand">
        <Description><![CDATA[<p>Afstand til den nærmeste forudindstillede farve</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="Rød">
        <Description><![CDATA[<p>Kvadreret afstand fra input-RGB til Rød-reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="Grøn">
        <Description><![CDATA[<p>Kvadreret afstand fra input-RGB til Grøn-reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="Blå">
        <Description><![CDATA[<p>Kvadreret afstand fra input-RGB til Blå-reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="Gul">
        <Description><![CDATA[<p>Kvadreret afstand fra input-RGB til Gul-reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="Hvid">
        <Description><![CDATA[<p>Kvadreret afstand fra input-RGB til Hvid-reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="Sort">
        <Description><![CDATA[<p>Kvadreret afstand fra input-RGB til Sort-reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="Brun">
        <Description><![CDATA[<p>Kvadreret afstand fra input-RGB til Brun-reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="Pink">
        <Description><![CDATA[<p>Kvadreret afstand fra input-RGB til Pink-reference</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="Rød">
        <Description><![CDATA[<p>Afstand til Rød (fra Distance-tilstand)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="Grøn">
        <Description><![CDATA[<p>Afstand til Grøn (fra Distance-tilstand)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="Blå">
        <Description><![CDATA[<p>Afstand til Blå (fra Distance-tilstand)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="Gul">
        <Description><![CDATA[<p>Afstand til Gul (fra Distance-tilstand)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="Hvid">
        <Description><![CDATA[<p>Afstand til Hvid (fra Distance-tilstand)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="Sort">
        <Description><![CDATA[<p>Afstand til Sort (fra Distance-tilstand)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="Brun">
        <Description><![CDATA[<p>Afstand til Brun (fra Distance-tilstand)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="Pink">
        <Description><![CDATA[<p>Afstand til Pink (fra Distance-tilstand)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_R" DisplayName="R (Rød)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_G" DisplayName="G (Rød)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_B" DisplayName="B (Rød)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_R" DisplayName="R (Grøn)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_G" DisplayName="G (Grøn)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_B" DisplayName="B (Grøn)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_R" DisplayName="R (Blå)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_G" DisplayName="G (Blå)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_B" DisplayName="B (Blå)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_R" DisplayName="R (Gul)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_G" DisplayName="G (Gul)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_B" DisplayName="B (Gul)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_R" DisplayName="R (Hvid)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_G" DisplayName="G (Hvid)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_B" DisplayName="B (Hvid)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_R" DisplayName="R (Sort)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_G" DisplayName="G (Sort)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_B" DisplayName="B (Sort)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_R" DisplayName="R (Brun)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_G" DisplayName="G (Brun)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_B" DisplayName="B (Brun)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_R" DisplayName="R (Pink)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_G" DisplayName="G (Pink)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_B" DisplayName="B (Pink)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="Normaliser – RGB">
        <Description><![CDATA[<p>Konverterer rå R, G, B til forhold (hver kanal divideret med summen, × 100). Fjerner lysstyrkens påvirkning.</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="Opsætning">
        <Block Mode="Setup_Red" DisplayName="Opsæt Rød">
          <Description><![CDATA[<p>Gem reference-RGB for Rød (standard: R=255, G=0, B=0). Kald én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="Opsæt Grøn">
          <Description><![CDATA[<p>Gem reference-RGB for Grøn (standard: R=0, G=255, B=0). Kald én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="Opsæt Blå">
          <Description><![CDATA[<p>Gem reference-RGB for Blå (standard: R=0, G=0, B=255). Kald én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="Opsæt Gul">
          <Description><![CDATA[<p>Gem reference-RGB for Gul (standard: R=255, G=255, B=0). Kald én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="Opsæt Hvid">
          <Description><![CDATA[<p>Gem reference-RGB for Hvid (standard: R=255, G=255, B=255). Kald én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="Opsæt Sort">
          <Description><![CDATA[<p>Gem reference-RGB for Sort (standard: R=0, G=0, B=0). Kald én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="Opsæt Brun">
          <Description><![CDATA[<p>Gem reference-RGB for Brun (standard: R=128, G=64, B=0). Kald én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="Opsæt Pink">
          <Description><![CDATA[<p>Gem reference-RGB for Pink (standard: R=200, G=50, B=150). Kald én gang ved programstart.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Enable" DisplayName="Aktiver farver">
          <Description><![CDATA[<p>Angiver hvilke farver der er aktive (1=til, 0=fra). Deaktiverede farver giver afstand 999999 og vælges aldrig af Identify.</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="Afstand">
        <Description><![CDATA[<p>Beregner den kvadrerede afstand fra live RGB til hver af de 8 forudindstillede farver. Forbind udgangene til Identify-blokken.</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="Identificer">
        <Description><![CDATA[<p>Tager de 8 afstande fra Distance-blokken og returnerer indekset (1–8) for den nærmeste farve plus den faktiske afstand.</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>

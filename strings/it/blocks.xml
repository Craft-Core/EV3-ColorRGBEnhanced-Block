<?xml version="1.0" encoding="utf-8"?>
<EditorStrings>
  <PolyGroups ModuleName="ColorSensorRGB">
    <PolyGroup Name="ColorSensorRGB" DisplayName="Sensore di colore RGB avanzato" DisplayNamePrefix="ColorSensorRGB">
      <Parameter Name="Port" DisplayName="Porta">
        <Description><![CDATA[<p>Porta del sensore (1–4) del sensore colore EV3</p>]]></Description>
      </Parameter>
      <Parameter Name="Red" DisplayName="Rosso">
        <Description><![CDATA[<p>Componente rosso del RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green" DisplayName="Verde">
        <Description><![CDATA[<p>Componente verde del RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue" DisplayName="Blu">
        <Description><![CDATA[<p>Componente blu del RGB (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Range" DisplayName="Riferimento rosso">
        <Description><![CDATA[<p>Valore rosso di riferimento per il confronto</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Range" DisplayName="Riferimento verde">
        <Description><![CDATA[<p>Valore verde di riferimento per il confronto</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Range" DisplayName="Riferimento blu">
        <Description><![CDATA[<p>Valore blu di riferimento per il confronto</p>]]></Description>
      </Parameter>
      <Parameter Name="Error_Amount" DisplayName="Tolleranza">
        <Description><![CDATA[<p>Scostamento ammesso per canale per una corrispondenza positiva</p>]]></Description>
      </Parameter>
      <Parameter Name="Result" DisplayName="Corrisponde">
        <Description><![CDATA[<p>Vero se l’RGB misurato è entro la tolleranza</p>]]></Description>
      </Parameter>
      <Parameter Name="Hue" DisplayName="Tonalità">
        <Description><![CDATA[<p>Componente tonalità (0–360 gradi)</p>]]></Description>
      </Parameter>
      <Parameter Name="Saturation" DisplayName="Saturazione">
        <Description><![CDATA[<p>Componente saturazione (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Value" DisplayName="Valore">
        <Description><![CDATA[<p>Valore/luminosità (0–100)</p>]]></Description>
      </Parameter>
      <Parameter Name="Lightness" DisplayName="Chiarezza">
        <Description><![CDATA[<p>Chiarezza (0–100)</p>]]></Description>
      </Parameter>
      <Block Mode="ReadRGB" DisplayName="Misurare – colore RGB">
        <Description><![CDATA[<p>Legge i valori grezzi Rosso, Verde e Blu dal sensore di colore.</p>]]></Description>
      </Block>
      <Block Mode="ReadHSV" DisplayName="Misurare – colore HSVL">
        <Description><![CDATA[<p>Legge tonalità, saturazione, valore e chiarezza derivati dall’RGB del sensore.</p>]]></Description>
      </Block>
      <Block Mode="DectRGB" DisplayName="Confrontare – colore RGB">
        <Description><![CDATA[<p>Confronta l’RGB in tempo reale con un triplo di riferimento e restituisce un booleano.</p>]]></Description>
      </Block>
    </PolyGroup>
    <PolyGroup Name="ColorClassifier" DisplayName="Classificatore di colore" DisplayNamePrefix="ColorClassifier">
      <Description><![CDATA[<p>Utilità di classificazione del colore basate sulla distanza per la scheda Operazioni sui dati.</p>]]></Description>
      <Parameter Name="R_in" DisplayName="Ingresso R">
        <Description><![CDATA[<p>Valore rosso in tempo reale da classificare</p>]]></Description>
      </Parameter>
      <Parameter Name="G_in" DisplayName="Ingresso G">
        <Description><![CDATA[<p>Valore verde in tempo reale da classificare</p>]]></Description>
      </Parameter>
      <Parameter Name="B_in" DisplayName="Ingresso B">
        <Description><![CDATA[<p>Valore blu in tempo reale da classificare</p>]]></Description>
      </Parameter>
      <Parameter Name="R_n" DisplayName="Rn">
        <Description><![CDATA[<p>Rosso normalizzato: R / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="G_n" DisplayName="Gn">
        <Description><![CDATA[<p>Verde normalizzato: G / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="B_n" DisplayName="Bn">
        <Description><![CDATA[<p>Blu normalizzato: B / (R+G+B) × 100</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_R" DisplayName="Riferimento R">
        <Description><![CDATA[<p>Valore rosso del colore predefinito da memorizzare</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_G" DisplayName="Riferimento G">
        <Description><![CDATA[<p>Valore verde del colore predefinito da memorizzare</p>]]></Description>
      </Parameter>
      <Parameter Name="Ref_B" DisplayName="Riferimento B">
        <Description><![CDATA[<p>Valore blu del colore predefinito da memorizzare</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Red" DisplayName="Attiva Rosso">
        <Description><![CDATA[<p>1 = includi Rosso nella classificazione, 0 = ignora Rosso</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Green" DisplayName="Attiva Verde">
        <Description><![CDATA[<p>1 = includi Verde nella classificazione, 0 = ignora Verde</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Blue" DisplayName="Attiva Blu">
        <Description><![CDATA[<p>1 = includi Blu nella classificazione, 0 = ignora Blu</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Yellow" DisplayName="Attiva Giallo">
        <Description><![CDATA[<p>1 = includi Giallo nella classificazione, 0 = ignora Giallo</p>]]></Description>
      </Parameter>
      <Parameter Name="En_White" DisplayName="Attiva Bianco">
        <Description><![CDATA[<p>1 = includi Bianco nella classificazione, 0 = ignora Bianco</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Black" DisplayName="Attiva Nero">
        <Description><![CDATA[<p>1 = includi Nero nella classificazione, 0 = ignora Nero</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Brown" DisplayName="Attiva Marrone">
        <Description><![CDATA[<p>1 = includi Marrone nella classificazione, 0 = ignora Marrone</p>]]></Description>
      </Parameter>
      <Parameter Name="En_Pink" DisplayName="Attiva Rosa">
        <Description><![CDATA[<p>1 = includi Rosa nella classificazione, 0 = ignora Rosa</p>]]></Description>
      </Parameter>
      <Parameter Name="BestColor" DisplayName="Miglior colore">
        <Description><![CDATA[<p>Indice (1–8) del colore predefinito più vicino</p>]]></Description>
      </Parameter>
      <Parameter Name="BestDistance" DisplayName="Miglior distanza">
        <Description><![CDATA[<p>Distanza dal colore più vicino</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red" DisplayName="Rosso">
        <Description><![CDATA[<p>Distanza quadratica dall'RGB in ingresso al riferimento Rosso</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green" DisplayName="Verde">
        <Description><![CDATA[<p>Distanza quadratica dall'RGB in ingresso al riferimento Verde</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue" DisplayName="Blu">
        <Description><![CDATA[<p>Distanza quadratica dall'RGB in ingresso al riferimento Blu</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow" DisplayName="Giallo">
        <Description><![CDATA[<p>Distanza quadratica dall'RGB in ingresso al riferimento Giallo</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White" DisplayName="Bianco">
        <Description><![CDATA[<p>Distanza quadratica dall'RGB in ingresso al riferimento Bianco</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black" DisplayName="Nero">
        <Description><![CDATA[<p>Distanza quadratica dall'RGB in ingresso al riferimento Nero</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown" DisplayName="Marrone">
        <Description><![CDATA[<p>Distanza quadratica dall'RGB in ingresso al riferimento Marrone</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink" DisplayName="Rosa">
        <Description><![CDATA[<p>Distanza quadratica dall'RGB in ingresso al riferimento Rosa</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Red_in" DisplayName="Rosso">
        <Description><![CDATA[<p>Distanza verso Rosso (dalla modalità Distance)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Green_in" DisplayName="Verde">
        <Description><![CDATA[<p>Distanza verso Verde (dalla modalità Distance)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Blue_in" DisplayName="Blu">
        <Description><![CDATA[<p>Distanza verso Blu (dalla modalità Distance)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Yellow_in" DisplayName="Giallo">
        <Description><![CDATA[<p>Distanza verso Giallo (dalla modalità Distance)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_White_in" DisplayName="Bianco">
        <Description><![CDATA[<p>Distanza verso Bianco (dalla modalità Distance)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Black_in" DisplayName="Nero">
        <Description><![CDATA[<p>Distanza verso Nero (dalla modalità Distance)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Brown_in" DisplayName="Marrone">
        <Description><![CDATA[<p>Distanza verso Marrone (dalla modalità Distance)</p>]]></Description>
      </Parameter>
      <Parameter Name="D_Pink_in" DisplayName="Rosa">
        <Description><![CDATA[<p>Distanza verso Rosa (dalla modalità Distance)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_R" DisplayName="R (Rosso)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_G" DisplayName="G (Rosso)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Red_Ref_B" DisplayName="B (Rosso)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_R" DisplayName="R (Verde)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_G" DisplayName="G (Verde)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Green_Ref_B" DisplayName="B (Verde)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_R" DisplayName="R (Blu)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_G" DisplayName="G (Blu)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Blue_Ref_B" DisplayName="B (Blu)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_R" DisplayName="R (Giallo)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_G" DisplayName="G (Giallo)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Yellow_Ref_B" DisplayName="B (Giallo)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_R" DisplayName="R (Bianco)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_G" DisplayName="G (Bianco)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="White_Ref_B" DisplayName="B (Bianco)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_R" DisplayName="R (Nero)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_G" DisplayName="G (Nero)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Black_Ref_B" DisplayName="B (Nero)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_R" DisplayName="R (Marrone)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_G" DisplayName="G (Marrone)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Brown_Ref_B" DisplayName="B (Marrone)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_R" DisplayName="R (Rosa)">
        <Description><![CDATA[<p>R (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_G" DisplayName="G (Rosa)">
        <Description><![CDATA[<p>G (0–255)</p>]]></Description>
      </Parameter>
      <Parameter Name="Pink_Ref_B" DisplayName="B (Rosa)">
        <Description><![CDATA[<p>B (0–255)</p>]]></Description>
      </Parameter>
      <Block Mode="Normalize" DisplayName="Normalizzare – RGB">
        <Description><![CDATA[<p>Converte R, G, B grezzi in rapporti (ogni canale diviso per la somma, × 100). Rimuove la luminosità e mantiene solo il colore.</p>]]></Description>
      </Block>
      <Category Name="Setup" DisplayName="Impostazione">
        <Block Mode="Setup_Red" DisplayName="Imposta Rosso">
          <Description><![CDATA[<p>Memorizzare il RGB di riferimento per Rosso (predefinito: R=255, G=0, B=0). Chiamare una volta all'avvio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Green" DisplayName="Imposta Verde">
          <Description><![CDATA[<p>Memorizzare il RGB di riferimento per Verde (predefinito: R=0, G=255, B=0). Chiamare una volta all'avvio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Blue" DisplayName="Imposta Blu">
          <Description><![CDATA[<p>Memorizzare il RGB di riferimento per Blu (predefinito: R=0, G=0, B=255). Chiamare una volta all'avvio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Yellow" DisplayName="Imposta Giallo">
          <Description><![CDATA[<p>Memorizzare il RGB di riferimento per Giallo (predefinito: R=255, G=255, B=0). Chiamare una volta all'avvio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_White" DisplayName="Imposta Bianco">
          <Description><![CDATA[<p>Memorizzare il RGB di riferimento per Bianco (predefinito: R=255, G=255, B=255). Chiamare una volta all'avvio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Black" DisplayName="Imposta Nero">
          <Description><![CDATA[<p>Memorizzare il RGB di riferimento per Nero (predefinito: R=0, G=0, B=0). Chiamare una volta all'avvio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Brown" DisplayName="Imposta Marrone">
          <Description><![CDATA[<p>Memorizzare il RGB di riferimento per Marrone (predefinito: R=128, G=64, B=0). Chiamare una volta all'avvio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Pink" DisplayName="Imposta Rosa">
          <Description><![CDATA[<p>Memorizzare il RGB di riferimento per Rosa (predefinito: R=200, G=50, B=150). Chiamare una volta all'avvio.</p>]]></Description>
        </Block>
        <Block Mode="Setup_Enable" DisplayName="Attiva colori">
          <Description><![CDATA[<p>Imposta quali colori sono attivi (1=sì, 0=no). I colori disattivati restituiscono distanza 999999 e Identifica non li seleziona mai.</p>]]></Description>
        </Block>
      </Category>
      <Block Mode="Distance" DisplayName="Distanza">
        <Description><![CDATA[<p>Calcola la distanza al quadrato dall’RGB in tempo reale a ciascuno degli 8 colori predefiniti. Cablare le uscite al blocco Identifica.</p>]]></Description>
      </Block>
      <Block Mode="Identify" DisplayName="Identifica">
        <Description><![CDATA[<p>Prende le 8 distanze dal blocco Distanza e restituisce l’indice (1–8) del colore più vicino e la distanza effettiva.</p>]]></Description>
      </Block>
    </PolyGroup>
  </PolyGroups>
</EditorStrings>
